## Copy to local.properties (gitignored) and fill as needed.
## sdk.dir is usually auto-written by Android Studio.

# sdk.dir=/path/to/Android/sdk

# Optional SecureLine public URLs (also injectable via env / CI)
# SECURELINE_GITHUB_REPO_URL=https://github.com/org/secureline
# SECURELINE_GITHUB_OWNER=org
# SECURELINE_GITHUB_REPO=secureline
# SECURELINE_TELEGRAM_CHANNEL_URL=https://t.me/secureline
# SECURELINE_FIREBASE_ENABLED=false
